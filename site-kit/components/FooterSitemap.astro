---
// The footer's site map (hub only): every page this build serves and indexes, in five columns.
// Nothing is typed in by hand. The routes come from the same sources the build renders them from:
//   the layout's own pages     site/src/pages/**/*.astro (static routes; redirect pages are noindex)
//   engine pages               routable() (published, or scheduled and past due; site-kit/engine-content)
//   games                      the catalog (published games this build shows) + coming-soon pages
//   apps                       site/generated/public/<app>/index.html (the hub's Battlefield copy)
// then the lifecycle takes out what this build hides (site-kit/lifecycle.mjs: Kaiju on production).
// Columns, leads and labels: site-kit/footer-map.mjs; the last column is the family line (FAMILY_LINE there). Checked by tests/site-footer.mjs.
import { existsSync, readdirSync, readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { routable, routeOf, dateOf } from '../engine-content';
import { catalog } from '../catalog';
import { SOON_GAMES } from '../coming-soon';
import { gameShown, linksHidden } from '../lifecycle.mjs';
import { FAMILY_LINE, GROUPS, SELF, groupOf, unlisted } from '../footer-map.mjs';

const { base } = Astro.props;
const current = Astro.url.pathname;

type Entry = { route: string; label: string; rank: number; sort: string };
const entries = new Map<string, Entry>();
const add = (route: string, label: string, rank: number, sort = '') => {
  if (!entries.has(route) && !unlisted(route) && !linksHidden(route || '/')) entries.set(route, { route, label, rank, sort });
};
const shortTitle = (t = '') => t.split(/\s[|·—]\s|:\s/)[0].trim();

// Games first, in shelf order, so their names win over a layout page's.
catalog.forEach((g, i) => add(g.route, g.name, 100 + i));
SOON_GAMES.filter((g) => g.page === `games/${g.id}/` && gameShown(g.id)).forEach((g, i) => add(g.page!, g.name, 200 + i));

// Engine pages: posts newest first, the rest by name. A page is named by its hero heading.
for (const p of routable()) {
  const type = p.meta?.pageType ?? '';
  const heading = p.sections?.find((s) => s.type === 'hero')?.heading;
  const post = type === 'blog' || type === 'news';
  const newestFirst = String(99999999 - Number(dateOf(p).replace(/-/g, '') || 0)).padStart(8, '0');
  add(routeOf(p), heading || shortTitle(p.seo.title), post ? 300 : 1000, post ? newestFirst : '');
}

// The layout's own pages: static routes in site/src/pages (dynamic ones are covered above).
const layoutPages = import.meta.glob('/site/src/pages/**/*.astro', { eager: true, query: '?raw', import: 'default' }) as Record<string, string>;
for (const [file, source] of Object.entries(layoutPages)) {
  const path = file.replace('/site/src/pages/', '').replace(/(^|\/)index\.astro$/, '$1').replace(/\.astro$/, '/');
  if (path.includes('[') || path.startsWith('404') || /noindex/.test(source)) continue;
  add(path, '', 1000);
}

// Apps the hub serves as-is (site/generated/public, written by site-kit/scripts/prepare.mjs).
const apps = resolve(process.cwd(), 'site/generated/public');
if (existsSync(apps))
  for (const d of readdirSync(apps, { withFileTypes: true })) {
    const html = d.isDirectory() && existsSync(resolve(apps, d.name, 'index.html')) ? readFileSync(resolve(apps, d.name, 'index.html'), 'utf8') : '';
    if (html && !/<meta name="robots" content="[^"]*noindex/.test(html)) add(`${d.name}/`, shortTitle(html.match(/<title>([^<]*)<\/title>/)?.[1]), 1000);
  }

const columns = GROUPS.map((g) => ({
  ...g,
  links: [...entries.values()]
    .filter((e) => groupOf(e.route) === g.id)
    .map((e) => ({ ...e, label: g.labels[e.route] || e.label || e.route, rank: g.lead.includes(e.route) ? g.lead.indexOf(e.route) : e.rank }))
    .sort((a, b) => a.rank - b.rank || a.sort.localeCompare(b.sort) || a.label.localeCompare(b.label)),
})).filter((g) => g.external || g.links.length);
---
<nav class="footer-sitemap" aria-label="Site map">
  {columns.map((col, i) => (
    <div class="col">
      <h2 class="col-heading"><span class="col-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{col.heading}</h2>
      <ul>
        {col.external
          ? FAMILY_LINE.map((f) => <li><a href={f.href}>{f.label}{f.href !== SELF && <span class="out" aria-hidden="true"> ↗</span>}</a></li>)
          : col.links.map((l) => <li><a href={`${base}${l.route}`} aria-current={current === `${base}${l.route}` ? 'page' : undefined}>{l.label}</a></li>)}
        {col.id === 'news' && <li class="feed"><a href={`${base}feed.xml`}>RSS feed</a></li>}
      </ul>
    </div>
  ))}
</nav>

<style>
  /* Six columns on desktop, three on tablets, one on phones (each list in two). Hub tokens only. */
  .footer-sitemap {
    flex-basis: 100%;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 28px 32px;
    padding-block: 26px 28px;
    border-block: 1px solid var(--line);
  }
  .col {
    min-width: 0;
  }
  .col-heading {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0 0 12px;
    font: 10px/1.5 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .col-index {
    color: var(--accent-text, var(--accent));
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    font: 13px/1.45 Inter, Arial, Helvetica, sans-serif;
    letter-spacing: 0;
  }
  li {
    break-inside: avoid;
  }
  a {
    display: inline-block;
    padding-block: 3px;
    color: var(--muted);
    text-decoration: none;
    transition: color 140ms ease;
  }
  a:focus-visible {
    outline-offset: 2px; /* the site's ring, close enough not to cover the next row */
  }
  a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  a[aria-current='page'] {
    color: var(--accent-text, var(--accent));
    text-decoration: underline;
  }
  .feed a {
    font: 10px/1.6 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding-top: 9px;
  }
  @media (max-width: 1000px) {
    .footer-sitemap {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .footer-sitemap {
      grid-column: 1 / -1;
      grid-row: 2;
      grid-template-columns: minmax(0, 1fr);
      gap: 22px;
      padding-block: 20px 6px;
      border-bottom: 0;
    }
    ul {
      columns: 2;
      column-gap: 16px;
    }
  }
</style>
