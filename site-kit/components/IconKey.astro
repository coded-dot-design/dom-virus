---
// A square 3D icon key whose label slides out on hover / keyboard focus (touch shows just the
// icon; the label is still the accessible name). Used for secondary actions next to a big
// primary button, so Play stays the one obvious thing to press.
// accent: a game accent class (e.g. "accent-cyan") paints the key in that game's colour.
const { href, label, accent, title } = Astro.props;
---
<a class:list={["icon-key", accent && `filled ${accent}`]} href={href} aria-label={label} title={title}><span class="ik-icon" aria-hidden="true"><slot/></span><span class="ik-label" aria-hidden="true">{label}</span></a>
<style>
.icon-key{display:inline-flex;align-items:center;height:46px;min-width:46px;padding:0;color:var(--ink);text-decoration:none;background:var(--surface);border:2px solid var(--ink);border-radius:9px;box-shadow:3px 3px 0 var(--ink);overflow:hidden;white-space:nowrap;transition:transform 140ms cubic-bezier(.2,.8,.2,1),box-shadow 140ms cubic-bezier(.2,.8,.2,1)}
.icon-key.filled{background:var(--accent);color:#171022}
.ik-icon{display:grid;place-items:center;flex:0 0 42px;height:42px}
.ik-icon :global(svg){width:22px;height:22px}
.ik-label{max-width:0;opacity:0;font:700 11px/1 var(--mono);letter-spacing:.08em;text-transform:uppercase;transition:max-width 240ms cubic-bezier(.2,.8,.2,1),opacity 160ms,padding 240ms}
.icon-key:focus-visible .ik-label{max-width:190px;opacity:1;padding-right:14px}
@media (hover:hover) and (pointer:fine){
  .icon-key:hover{transform:translate(-2px,-2px);box-shadow:5px 5px 0 var(--ink)}
  .icon-key:hover .ik-label{max-width:190px;opacity:1;padding-right:14px}
}
.icon-key:active{transform:translate(3px,3px);box-shadow:0 0 0 var(--ink);transition-duration:55ms}
@media (prefers-reduced-motion:reduce){.icon-key,.ik-label{transition:none}}
</style>
