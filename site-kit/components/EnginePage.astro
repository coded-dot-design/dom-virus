---
// Renders an astro-base-engine page (blog, news, about, legal, contact, support, section indexes)
// with the hub's own pieces: section heading, cards, nerd-link rows, fact boxes, deep-dive FAQ.
// Copy comes only from the page JSON; lists (posts, games) come from the site's data.
import UiIcon from './UiIcon.astro';
import Icon from './AbstractIcon.astro';
import { posts, dateOf, formatDate, routeOf, type EnginePage } from '../engine-content';
const { page, base = '/', games = [] } = Astro.props as { page: EnginePage; base: string; games: any[] };
const type = page.meta?.pageType || '';
const article = page.template === 'article';
const [hero, ...sections] = page.sections;
// Hub-relative links get the base path and a trailing slash (the site's URL rule, SITEMAP E5).
const slash = (h: string) => { const [, path, rest] = h.match(/^([^#?]*)(.*)$/)!; return (path.endsWith('/') || /\.[a-z0-9]+$/i.test(path) ? path : path + '/') + rest; };
const href = (h: string) => (h.startsWith('/') ? base + slash(h).slice(1) : h);
const rowLabel = (l: string) => (/^read:/i.test(l) ? 'READ' : l).toUpperCase();
const external = (h: string) => /^https?:/.test(h);
const tag = ({ blog: 'BLOG', news: 'NEWS', legal: 'LEGAL', 'legal-home': 'LEGAL', 'about-home': 'ABOUT', about: 'ABOUT', contact: 'HELLO', support: 'BACK IT', section: 'INDEX', 'games-section': 'GAMES', engine: 'ENG' } as Record<string, string>)[type] || 'DOM';
const date = article ? dateOf(page) : '';
const list = page.id === 'blog' ? posts('blog') : page.id === 'news' ? posts('news') : [];
const gameList = page.id === 'games' ? games : [];
const closing = page.meta?.closing;
const isPost = type === 'blog' || type === 'news';
---
<article class:list={['engine-page', { 'is-article': article }]} aria-labelledby="page-title" data-engine-page={page.id}>
  <div class="section-heading"><span class="eyebrow"><span class="index">{tag}</span> {(hero.eyebrow || '').toUpperCase() === tag ? '' : (hero.eyebrow || '').toUpperCase()}</span>{date ? <time class="version" datetime={date}>{formatDate(date)}</time> : <span class="version">BY CHRIS COOLEY · CODED.DESIGN</span>}</div>
  <header class="engine-hero">
    <h1 id="page-title">{hero.heading}{hero.headingAccent && <><br/><em>{hero.headingAccent}</em></>}</h1>
    {hero.body && <p class="lead">{hero.body}</p>}
    {isPost && <p class="byline">By <a href={`${base}about/`} rel="author">Chris Cooley</a> · <a href="https://coded.design">coded.design</a></p>}
    {hero.ctas?.length > 0 && <div class="actions" data-virus-ignore data-swarm-ignore>{hero.ctas.map((c: any, i: number) => <a class:list={['button', { primary: i === 0 }]} href={href(c.href)}>{c.label} {external(c.href) && c.href.includes('github.com') ? <UiIcon name="github" size={18}/> : <UiIcon name="arrow-up-right" size={17}/>}</a>)}</div>}
  </header>

  {gameList.length > 0 && <section class="engine-block" aria-labelledby="games-h"><h2 id="games-h">Play now</h2><ol class="engine-cards">{gameList.map((g: any) => <li class:list={['card', `accent-${g.accent}`]}><div class="engine-game"><span class="engine-game-art" aria-hidden="true"><Icon kind={g.icon} size={40}/></span><div><span class="eyebrow">{g.kind}</span><h3>{g.name}</h3><p>{g.tagline}</p><a class="text-link" href={`${base}games/${g.id}/`}>Play {g.name} <UiIcon name="arrow-up-right" size={15}/></a></div></div></li>)}</ol></section>}
  {sections.map((s: any) => (
    s.type === 'richText' ? <div class="engine-prose">{s.blocks.map((b: any) => <p>{b.spans.map((x: any) => x.text).join('')}</p>)}</div>
    : s.type === 'prose' ? <section class="engine-prose" aria-labelledby={`${s.id}-h`}><h2 id={`${s.id}-h`}>{s.heading}{s.headingAccent && <em> {s.headingAccent}</em>}</h2>{s.body.map((p: string) => <p>{p}</p>)}</section>
    : s.type === 'statStrip' ? <section class="engine-block" aria-label={s.heading || 'At a glance'}>{s.heading && <div class="eyebrow">{s.heading.toUpperCase()}</div>}<div class="game-facts">{s.items.map((i: any) => <div><b>{i.value}</b><span>{i.label}</span></div>)}</div></section>
    : s.type === 'featureList' ? <section class:list={['engine-block', `features-${s.variant}`]} aria-labelledby={`${s.id}-h`}>
        {s.eyebrow && <div class="eyebrow">{s.eyebrow.toUpperCase()}</div>}
        <h2 id={`${s.id}-h`}>{s.heading}{s.headingAccent && <em> {s.headingAccent}</em>}</h2>
        {s.subhead && <p class="engine-sub">{s.subhead}</p>}
        {s.variant === 'rows'
          ? <div class="engine-rows">{s.items.map((i: any) => i.link
              ? <a class="nerd-link card" href={href(i.link.href)}><span class="eyebrow">{rowLabel(i.link.label)}</span><strong>{i.title}</strong><span>{i.body}</span>{external(i.link.href) && i.link.href.includes('github.com') ? <UiIcon name="github" size={20}/> : <UiIcon name="arrow-up-right" size={20}/>}</a>
              : <div class="nerd-link card is-static"><strong>{i.title}</strong><span>{i.body}</span></div>)}</div>
          : <ol class:list={['engine-cards', { steps: s.variant === 'steps' }]}>{s.items.map((i: any, n: number) => <li class="card">{s.variant === 'steps' && <span class="tag">0{n + 1}</span>}<div><h3>{i.title}</h3><p>{i.body}</p>{i.link && <a class="text-link" href={href(i.link.href)}>{i.link.label} <UiIcon name="arrow-up-right" size={15}/></a>}</div></li>)}</ol>}
      </section>
    : s.type === 'faq' ? <section class="engine-block" aria-labelledby="faq-h"><div class="eyebrow">FAQ</div><h2 id="faq-h">{s.heading}</h2>{s.items.map((i: any) => <details class="deep-dive"><summary data-virus-ignore data-swarm-ignore>{i.question} <UiIcon name="chevron-down" class="disclosure-icon"/></summary><p>{i.answer}</p></details>)}</section>
    : s.type === 'quote' ? <figure class="engine-quote card"><blockquote><p>{s.quote}</p></blockquote>{s.attribution && <figcaption>{s.attribution}</figcaption>}</figure>
    : s.type === 'mediaFigure' ? <figure class="engine-figure">{s.heading && <h2>{s.heading}</h2>}<img src={href(s.image.src)} alt={s.image.alt} loading="lazy"/>{s.caption && <figcaption>{s.caption}</figcaption>}</figure>
    : null
  ))}

  {list.length > 0 && <section class="engine-block" aria-labelledby="list-h"><h2 id="list-h" class="visually-hidden">All posts</h2><div class="engine-rows">{list.map((p) => <a class="nerd-link card" href={`${base}${routeOf(p)}`}><span class="eyebrow">{formatDate(dateOf(p)).toUpperCase()}{p.meta?.tags?.[0] ? ` · ${p.meta.tags[0].toUpperCase()}` : ''}</span><strong>{p.sections[0].heading}</strong><span>{p.seo.description}</span><UiIcon name="arrow-up-right" size={20}/></a>)}</div></section>}
  {(page.id === 'blog' || page.id === 'news') && list.length === 0 && <p class="engine-sub">First posts land soon.</p>}



  {closing && <section class="engine-closing card" aria-labelledby="closing-h">{closing.eyebrow && <div class="eyebrow">{closing.eyebrow.toUpperCase()}</div>}<h2 id="closing-h">{closing.headlineTop}{closing.headlineBottom && <em> {closing.headlineBottom}</em>}</h2>{closing.body && <p>{closing.body}</p>}{closing.ctaHref && <a class="button primary" href={href(closing.ctaHref)}>{closing.ctaLabel}</a>}</section>}
</article>
<style>
.engine-page{max-width:1200px;margin:0 auto;padding:40px 30px 80px}
.engine-hero h1{margin:18px 0 14px;font-size:clamp(42px,6.4vw,84px);line-height:.98;letter-spacing:-.04em;max-width:16ch}
.is-article .engine-hero h1{font-size:clamp(36px,5vw,64px);max-width:22ch}
.engine-hero h1 em,.engine-page h2 em{font-style:normal;color:var(--accent-text,var(--accent))}
.engine-page h2 em{display:block}
.engine-hero .lead{max-width:680px;margin:0;color:var(--muted);font-size:17px;line-height:1.6}
.byline{margin:16px 0 0;font:11px/1.6 var(--mono);color:var(--muted)}
.byline a{color:inherit}
.engine-hero .actions{margin-top:26px;display:flex;flex-wrap:wrap;gap:12px}
.engine-prose{max-width:720px;margin-top:40px}
.engine-prose h2{margin:0 0 14px;font-size:clamp(24px,2.6vw,32px);letter-spacing:-.02em}
.engine-prose p{margin:0 0 16px;font-size:16px;line-height:1.75;color:var(--muted)}
.engine-prose p:first-of-type{color:inherit}
.engine-block{margin-top:56px}
.engine-block > h2{margin:8px 0 18px;font-size:clamp(24px,2.8vw,34px);letter-spacing:-.02em}
.engine-sub{max-width:680px;margin:-6px 0 18px;color:var(--muted);line-height:1.6}
.engine-rows{display:grid;gap:4px}
.engine-rows .nerd-link{margin-top:14px;color:inherit;text-decoration:none}
.engine-rows .is-static{grid-template-columns:1fr}
.engine-cards{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:20px}
.engine-cards li{padding:20px;display:grid;gap:10px}
.engine-cards.steps li{grid-template-columns:auto 1fr}
.engine-cards h3{margin:0 0 6px;font-size:18px;letter-spacing:-.01em}
.engine-cards p{margin:0 0 10px;font-size:14px;line-height:1.6;color:var(--muted)}
.engine-game{display:grid;grid-template-columns:auto 1fr;gap:14px;align-items:start}
.engine-game-art{display:grid;place-items:center;width:58px;height:58px;color:var(--accent);background:#100a1b;border:2px solid var(--ink);border-radius:10px}
.engine-quote{margin:48px 0 0;padding:24px 26px;max-width:760px}
.engine-quote blockquote{margin:0}
.engine-quote p{margin:0;font-size:clamp(20px,2.2vw,26px);line-height:1.35;letter-spacing:-.01em}
.engine-quote figcaption{margin-top:12px;font:11px var(--mono);color:var(--muted)}
.engine-figure{margin:48px 0 0}
.engine-figure img{max-width:100%;height:auto;border:2px solid var(--ink);border-radius:8px}
.engine-closing{margin-top:64px;padding:26px}
.engine-closing h2{margin:8px 0 10px;font-size:clamp(24px,2.8vw,34px)}
.engine-closing p{margin:0 0 18px;color:var(--muted);max-width:640px}
.tag{align-self:start;padding:4px 8px;font:700 10px var(--mono);letter-spacing:1px;color:var(--accent-ink);background:var(--accent);border:2px solid var(--ink);border-radius:4px}
.visually-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
@media (max-width:760px){.engine-page{padding:28px 20px 60px}}
</style>
