---
import { swapHref } from '../swap';
import Icon from './AbstractIcon.astro';
import UiIcon from './UiIcon.astro';
import IconKey from './IconKey.astro';
import CodePreview from './CodePreview.astro';
import CrossPromo from './CrossPromo.astro';
import GameSticker from './GameSticker.astro';
import Cartridge from './Cartridge.astro';
import CharacterIcon from './Icon.astro';
import battlefieldIcon from '../assets/battlefield-icon.svg?raw';
// mode: 'full' (single-game sites: everything inline) | 'page' (hub game page; details live on the nerd page).
// content: the astro-base-engine page JSON for this game page, when one exists (hub only). It supplies the
// marketing layer (lead, calls to action, related games, FAQ); gameplay facts stay in the game's own data.
const { game, index = 0, single = false, mode = 'full', base = '/', content } = Astro.props;
const page = mode === 'page';
const Title = page ? 'h1' : 'h2';
// One heading level down from the title, so the outline never skips a level (h1 → h2 → h3).
const Sub = page ? 'h2' : 'h3';
const SubSub = page ? 'h3' : 'h4';
const section = (type, variant) => content?.sections?.find((s) => s.type === type && (!variant || s.variant === variant));
const hero = section('hero');
const lead = hero?.body || game.description;
// Play stands alone in the hero (site rule); "get the code" copy sits with the install key below.
const play = hero?.ctas?.find((c) => c.href === '#play');
const support = section('richText')?.blocks?.flatMap((b) => b.spans?.map((x) => x.text) || []).join('') || '';
const related = section('featureList', 'cards');
const faq = section('faq');
// House rule (swap.ts): a related game with a cartridge on the hub shelf plays through the cartridge swap.
const SHELF = { 'DOM Battlefield': 'battlefield' };
const RELATED_LOOK = { 'DOM Battlefield': { accent: 'cyan', icon: 'battlefield' }, 'Battlefield Blitz': { accent: 'pink', icon: 'tank' } };
const repo=`https://github.com/coded-dot-design/${game.id}`;
const kb=(n)=> (n/1000).toFixed(1);
const enemy = ({ship:"ship",runner:"fly-chaser",bug:"bug",tank:"tank"})[game.icon];
// Control lines read "Keys — action · Keys — action". Keys become keycaps; plain-language
// inputs (touch D-pad, edge alerts) stay text chips. "Label: a · b" lines become chip rows.
const CAP = /^(?:[A-Z0-9]|Space|Esc|Enter|Shift|Tab|Click|Mouse|tap|Tap|Scroll)$/;
const keyToken = (t) => {
  t = t.trim();
  if (/^wasd$/i.test(t)) return { cluster: ['W', 'A', 'S', 'D'] };
  if (/^arrows$/i.test(t)) return { cluster: ['↑', '←', '↓', '→'] };
  if (/^(mouse|click|click \/ tap|tap)$/i.test(t)) return { mouse: t.replace(/^./, (c) => c.toUpperCase()) };
  if (CAP.test(t)) return { key: t };
  return { text: t };
};
const parseControl = (line) => {
  const label = line.match(/^([^—:]+):\s*(.+)$/);
  if (label && !line.includes(' — ')) return { label: label[1], chips: label[2].split(' · ') };
  return {
    pairs: line.split(/ · |;\s+(?=[^;]*\s—\s)/).map((part) => {
      const [keys, ...rest] = part.split(' — ');
      return { keys: keys.split(/\s+\/\s+/).map(keyToken), action: rest.join(' — ') };
    }),
  };
};
const controls = game.controls.map(parseControl);
---
<section id={game.id} class:list={['game-section', `accent-${game.accent}`, { standalone: page }]} aria-labelledby={`${game.id}-title`}>
  {page && <a class="back-link" href={`${base}?play=${game.id}#console`} data-virus-ignore data-swarm-ignore><span class="eject-key" aria-hidden="true"><UiIcon name="eject" size={16}/></span> Eject cartridge</a>}
  <div class="section-heading"><span class="eyebrow"><span class="index">0{index+1}</span> {game.kind}</span><span class="version">v{game.version} / MIT</span></div>
  <div class="game-intro">
    <div><Title id={`${game.id}-title`}>{game.name}<span>{game.tagline}</span></Title><p class="lead">{lead}</p><div class="actions" data-virus-ignore data-swarm-ignore><button class="button primary" data-launch={game.id}><UiIcon name="play" size={18}/> {play?.label || `Play ${game.name}`}</button>{page
      ? null
      : <>{game.id === "sherman-bytes" && <a class="button quiet battlefield-link" href={`${base}battlefield/`}><Fragment set:html={battlefieldIcon}/> Open Battlefield</a>}<a class="button quiet" href={`${repo}#readme`}>Read the source <UiIcon name="github" size={18}/></a></>}</div>{game.archives?.length > 0 && <div class="release-picker" data-virus-ignore data-swarm-ignore><label for={`${game.id}-release`}>TEST A RELEASE</label><select id={`${game.id}-release`} data-release={game.id}><option value={game.id} data-version={`v${game.version}`}>Current · v{game.version}</option>{game.archives.map(release=><option value={release.key} data-version={release.version}>{release.version} · archived</option>)}</select><p>Play uses the selected build. Notes below describe the current release.</p></div>}<p class="credit">Created by <a href="https://www.linkedin.com/in/chriscooleyme" rel="author">Chris Cooley</a> · <a href="https://coded.design">coded.design</a></p></div>
    <div data-byte-obstacle class="game-display" data-cartridge={game.id} style={page ? 'view-transition-name: game-screen' : undefined} aria-label={`${game.name} gameplay illustration`}>
      <div class="display-top"><span class="led"></span> {game.kind}<span class="display-note">DOM / ACTIVE SURFACE</span></div>
      <div class="arena-copy"><span class="arena-line">THE PAGE IS</span><span class="arena-line">THE PLAYFIELD<span class="blinking-dot">.</span></span></div>
      <div class="demo-path"><i></i><i></i><i></i><i></i><i></i><i></i></div>
      <div class="arena-character"><Icon kind={game.icon} size={76}/></div>
      <div class="arena-enemy one"><Icon kind={enemy} size={34}/></div><div class="arena-enemy two"><Icon kind={game.icon === "runner" ? "fly-interceptor" : enemy} size={28}/></div><div class="arena-targets"><button data-arcade-target data-virus-target data-swarm-target>SPAWN_01</button><button data-arcade-target data-virus-target data-swarm-target>SPAWN_02</button></div>
      <div class="display-bottom"><span>{game.versionNote}</span><span>ARCADE SIGNALS / DOM TERRAIN</span></div>
    </div>
  </div>
  {game.id === "sherman-bytes" && <aside data-sherman-wall>HARD COVER / Drive around this bunker. Shells stop here.</aside>}
  <div class="game-facts"><div><b>{kb(game.metrics.gzip)}<small> kB</small></b><span>gzip · {game.id === 'swarm-protocol' ? 'full immediate path' : 'complete game + engine'}</span></div>{game.facts.map(f=><div><b>{f.value}</b><span>{f.label}</span></div>)}</div>
  {game.characters?.length > 0 && <div class="character-guide"><div class="eyebrow">MEET THE CHARACTERS</div><Sub>Know who’s on the page.</Sub><ul>{game.characters.map(character=><li><div data-byte-obstacle class="character-portrait"><CharacterIcon kind={character.icon} size={48} color={character.color || undefined}/></div><div><span class="eyebrow">{character.role}</span><SubSub>{character.name}</SubSub><p>{character.rules}</p></div></li>)}</ul></div>}
  <div class="game-bottom">
    <div class="game-loop"><div class="eyebrow">THE LOOP</div><ol>{game.loop.map((step,i)=><li><span>0{i+1}</span>{step}</li>)}</ol><div class="controls" data-virus-ignore data-swarm-ignore><Sub>Know your controls.</Sub><ul class="keymap">{controls.map(c=>c.pairs ? <li>{c.pairs.map(p=><span class="key-pair"><span class="keys">{p.keys.map((k,i)=><>{i>0 && <i class="key-or">/</i>}{k.cluster ? <span class={`key-cluster${k.cluster[0]==='W'?' wasd':''}`} aria-label={k.cluster.join(' ')}>{k.cluster.map(c=><kbd class="keycap">{c}</kbd>)}</span> : k.mouse ? <kbd class="keycap mouse" aria-label={k.mouse}><svg viewBox="0 0 16 22" aria-hidden="true"><rect x="1.5" y="1.5" width="13" height="19" rx="6.5"/><path d="M8 1.5v6M1.5 8h13"/></svg><small>{k.mouse}</small></kbd> : k.key ? <kbd class={`keycap${k.key.length>1?' wide':''}`}>{k.key}</kbd> : <span class="key-chip">{k.text}</span>}</>)}</span>{p.action && <span class="key-action">{p.action}</span>}</span>)}</li> : <li class="key-row-label"><span class="key-label">{c.label}</span>{c.chips.map(x=><span class="key-chip">{x}</span>)}</li>)}</ul><p class="control-note">Sound starts after your first input. Minimize keeps the game running; Recall restores the page.</p></div></div>
    <div class="game-notes">{game.chapters.slice(0,2).map(chapter=><article><Sub>{chapter.title}</Sub><p>{chapter.body}</p></article>)}{page ? <a class="nerd-link card" href={`${repo}#readme`} data-virus-ignore data-swarm-ignore><span class="eyebrow">NERD NOTES · GITHUB</span><strong>How {game.name} works under the hood</strong><span>Engineering notes, budgets and source in the README</span><UiIcon name="github" size={20}/></a> : <details><summary data-virus-ignore data-swarm-ignore>Open the engineering notes <UiIcon name="chevron-down" class="disclosure-icon"/></summary><div>{game.chapters.slice(2).map(chapter=><article><h3>{chapter.title}</h3><p>{chapter.body}</p></article>)}<p>{game.extra}</p><div class="source-links" data-virus-ignore data-swarm-ignore>{game.sourcePaths.map(path=><a href={`${repo}/blob/main/${path}`}>{path} <UiIcon name="github" size={15}/></a>)}</div></div></details>}</div>
  </div>
  {page && related?.items?.length > 0 ? <div class="cross-links" role="group" aria-label={`${related.heading}: ${related.headingAccent || ''}`.replace(/: $/, '')}>{related.items.map((item) => <CrossPromo base={base} from={game.id} to={SHELF[item.title]} name={item.title} pitch={item.body} label={item.link?.label} href={SHELF[item.title] ? undefined : item.link?.href} eyebrow={related.heading.toUpperCase()} level="h2" {...RELATED_LOOK[item.title]}/>)}</div>
    : page && game.id === 'sherman-bytes' && <CrossPromo base={base} from="sherman-bytes" to="battlefield" level="h2"/>}
  {page && faq?.items?.length > 0 && <section class="game-faq" aria-labelledby={`${game.id}-faq`}><div class="eyebrow">FAQ</div><h2 id={`${game.id}-faq`}>{faq.heading}</h2>{faq.items.map((item) => <details class="deep-dive"><summary data-virus-ignore data-swarm-ignore>{item.question} <UiIcon name="chevron-down" class="disclosure-icon"/></summary><p>{item.answer}</p></details>)}</section>}
  {page && <div class="embed-game game-embed with-cart"><div class="embed-copy"><div class="embed-title"><GameSticker kind={game.icon} index={index}/><div><Sub>{game.name} on your site.</Sub><p>{game.engine}</p>{support && <p>{support}</p>}</div></div><div class="embed-cart" aria-hidden="true"><Cartridge id={game.id} placeholder accent={game.accent} index={index} kind={game.kind} name={game.name} tagline={game.tagline}><Icon kind={game.icon} size={44}/></Cartridge></div></div><CodePreview game={game} repo={repo}/></div>}
  {game.palette?.length > 0 && <footer class="game-palette" aria-label={`${game.name} color palette`} data-virus-ignore data-swarm-ignore><div class="eyebrow">GAME PALETTE / FULL SIGNAL</div><div class="palette-bar">{game.palette.map(swatch=><div class="palette-swatch"><i style={`--swatch:${swatch.color}`} aria-hidden="true"></i><span>{swatch.label}<code>{swatch.color}</code></span></div>)}</div></footer>}
</section>
