---
// One game cartridge: grip ridges, a label (art slot + text), gold contact pins.
// Shelf-level behaviour (pop-in, plug-in flight) lives in CartridgeShelf / client.ts.
const { id, href, accent, index = 0, kind, name, tagline } = Astro.props;
---
<a class:list={['cartridge', `accent-${accent}`]} href={href} data-cart={id} style={`--i:${index}`}>
  <span class="grip" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
  <span class="label">
    <span class="art" aria-hidden="true"><slot/></span>
    <small>0{index + 1} / {kind}</small>
    <strong>{name}</strong>
    <em>{tagline}</em>
  </span>
  <span class="pins" aria-hidden="true"></span>
</a>
<style>
.cartridge{position:relative;display:grid;grid-template-rows:28px 1fr 26px;min-height:250px;padding:0 14px;color:var(--ink);text-decoration:none;text-align:left;background:var(--accent);border:2px solid var(--ink);border-radius:12px 12px 4px 4px;clip-path:polygon(0 0,calc(100% - 22px) 0,100% 22px,100% 100%,0 100%);box-shadow:inset 0 -6px 0 color-mix(in srgb,var(--accent) 60%,#000);filter:drop-shadow(6px 6px 0 var(--ink)) drop-shadow(3px 3px 0 color-mix(in srgb,var(--accent) 45%,transparent));transition:transform 260ms cubic-bezier(.34,1.7,.5,1),filter 260ms cubic-bezier(.34,1.7,.5,1),opacity 200ms}
/* Same hard-shadow language as the site's buttons: the shadow grows on lift and collapses on press. */
@media (hover:hover) and (pointer:fine){.cartridge:hover{transform:translate(-3px,-10px) rotate(-1.5deg);filter:drop-shadow(10px 14px 0 var(--ink)) drop-shadow(4px 4px 0 color-mix(in srgb,var(--accent) 45%,transparent))}}
.cartridge:active{transform:translate(3px,3px) scale(.98);filter:drop-shadow(1px 1px 0 var(--ink));transition-duration:60ms}
.cartridge:focus-visible{outline:3px solid var(--ink);outline-offset:6px}
.cartridge:global(.plugging){z-index:30}
.grip{display:flex;flex-direction:column;justify-content:center;gap:3px;padding:0 26px 0 4px}
.grip i{display:block;height:2px;background:color-mix(in srgb,var(--ink) 35%,transparent)}
.label{display:grid;align-content:start;gap:4px;padding:14px 12px;background:var(--surface);border:2px solid var(--ink);border-radius:6px}
.art{display:grid;place-items:center;height:66px;margin-bottom:6px;color:var(--accent-text,var(--accent));background:color-mix(in srgb,var(--accent) 14%,var(--bg));border-radius:4px}
.art :global(svg){width:44px;height:44px}
small{font:9px/1.3 var(--mono);letter-spacing:.5px;color:var(--faint)}
strong{font-size:18px;line-height:1.15}
em{font-style:normal;font-size:12px;color:var(--muted)}
.pins{margin:6px 10px 0;background:repeating-linear-gradient(90deg,#ffd166 0 6px,transparent 6px 10px);border-top:2px solid var(--ink)}
@media (max-width:420px){.cartridge{min-height:220px;padding:0 9px}strong{font-size:15px}}
</style>
