---
// One game cartridge: grip ridges, a label (art slot + text), worn gold contact pins.
// The notched shell is its own layer so the hard drop-shadow follows the notch (a clip-path
// on the link itself would clip the shadow off the right side and the corner).
// `sleeve` makes it a special edition: pink trim and a sleeve over the bottom half that links
// to the detail page while the cartridge itself plugs in and launches the full game.
// Shelf-level behaviour (pop-in, plug-in flight) lives in CartridgeShelf / client.ts.
const { id, href, accent, index = 0, kind, name, tagline, sleeve, full } = Astro.props;
// Deterministic wear per cartridge: a few pins missing, worn short, or tarnished.
const pins = Array.from({ length: 11 }, (_, p) => {
  const h = (index * 31 + p * 17 + index * p * 7 + 5) % 23;
  return h < 2 ? 'gone' : h < 6 ? 'short' : h < 9 ? 'dim' : '';
});
---
<div class:list={['edition', { 'has-sleeve': !!sleeve }]} style={`--i:${index}`}>
  <a class:list={['cartridge', `accent-${accent}`, { special: !!sleeve }]} href={href} data-cart={id} data-full={full ? '' : undefined} style={`--i:${index}`}>
    <span class="shell" aria-hidden="true"></span>
    <span class="grip" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
    <span class="label">
      <span class="art" aria-hidden="true"><slot/></span>
      <small>0{index + 1} / {kind}</small>
      <strong>{name}</strong>
      <em>{tagline}</em>
    </span>
    <span class="pins" aria-hidden="true">{pins.map((wear) => <i class={wear || undefined}></i>)}</span>
  </a>
  {sleeve && (
    <a class="sleeve" href={sleeve} data-sleeve aria-label={`${name} details`}>
      <span class="tag">SPECIAL EDITION · FULL GAME</span>
      <span class="skel" aria-hidden="true"><i style="--w:86%"></i><i style="--w:64%"></i><i style="--w:74%"></i></span>
      <span class="more">DETAILS ▸</span>
    </a>
  )}
</div>
<style>
.cartridge{position:relative;isolation:isolate;display:grid;grid-template-rows:28px 1fr 26px;min-height:250px;padding:0 14px;color:var(--ink);text-decoration:none;text-align:left;filter:drop-shadow(6px 6px 0 var(--ink)) drop-shadow(3px 3px 0 color-mix(in srgb,var(--accent) 45%,transparent));transition:transform 260ms cubic-bezier(.34,1.7,.5,1),filter 260ms cubic-bezier(.34,1.7,.5,1),opacity 200ms}
/* Ink outline layer + accent fill inset 2px; the notch diagonal is offset so the outline stays 2px thick. */
.shell{position:absolute;inset:0;z-index:-1;background:var(--trim,var(--ink));border-radius:12px 12px 4px 4px;clip-path:polygon(0 0,calc(100% - 22px) 0,100% 22px,100% 100%,0 100%)}
.shell::before{content:"";position:absolute;inset:var(--trim-w,2px);background:var(--accent);border-radius:10px 10px 2px 2px;box-shadow:inset 0 -6px 0 color-mix(in srgb,var(--accent) 60%,#000);clip-path:polygon(0 0,calc(100% - var(--notch-in,20.8px)) 0,100% var(--notch-in,20.8px),100% 100%,0 100%)}
/* Same hard-shadow language as the site's buttons: the shadow grows on lift and collapses on press. */
@media (hover:hover) and (pointer:fine){.cartridge:hover{transform:translate(-3px,-10px) rotate(-1.5deg);filter:drop-shadow(10px 14px 0 var(--ink)) drop-shadow(4px 4px 0 color-mix(in srgb,var(--accent) 45%,transparent))}}
.cartridge:active{transform:translate(3px,3px) scale(.98);filter:drop-shadow(1px 1px 0 var(--ink));transition-duration:60ms}
.cartridge:focus-visible{outline:3px solid var(--ink);outline-offset:6px}
.cartridge:global(.plugging){z-index:30}
.grip{display:flex;flex-direction:column;justify-content:center;gap:3px;padding:0 26px 0 4px}
.grip i{display:block;height:2px;background:color-mix(in srgb,var(--ink) 35%,transparent)}
.label{display:grid;align-content:start;gap:4px;padding:14px 12px;background:var(--surface);border:2px solid var(--ink);border-radius:6px}
.art{display:grid;place-items:center;height:66px;margin-bottom:6px;color:var(--accent-text,var(--accent));background:color-mix(in srgb,var(--accent) 14%,var(--bg));border-radius:4px}
.art :global(svg){width:44px;height:44px}
small{font:9px/1.3 var(--mono);letter-spacing:.5px;color:var(--faint)}
strong{font-size:18px;line-height:1.15}
em{font-style:normal;font-size:12px;color:var(--muted)}
/* Contact pins: flat gold, with a few missing, worn down or tarnished. */
.pins{display:flex;align-items:flex-start;gap:4px;margin:6px 10px 0;padding-bottom:3px;border-top:2px solid var(--ink)}
.pins i{flex:1;height:100%;background:#ffd166;border-radius:0 0 2px 2px}
.pins i.short{height:52%}
.pins i.dim{background:color-mix(in srgb,#ffd166 45%,var(--ink))}
.pins i.gone{background:none;box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--ink) 28%,transparent);height:30%}

/* Special edition: pink trim, pink glow shadow, sleeve over the bottom half. */
.edition{position:relative;display:grid}
.special{--trim:#f4457a;--trim-w:3px;--notch-in:20.2px;filter:drop-shadow(6px 6px 0 var(--ink)) drop-shadow(3px 3px 0 #f4457a99)}
@media (hover:hover) and (pointer:fine){.special:hover{transform:translate(-2px,-26px) rotate(-1.5deg);filter:drop-shadow(10px 14px 0 var(--ink)) drop-shadow(4px 4px 0 #f4457a99)}}
.sleeve{position:absolute;z-index:31;left:-6px;right:-6px;bottom:-6px;height:37%;display:grid;align-content:start;gap:7px;padding:11px 16px 9px;color:#07060f;text-decoration:none;text-align:left;background:repeating-linear-gradient(135deg,#0000 0 9px,#ffffff1f 9px 11px),#f4457a;border:2px solid var(--ink);border-radius:6px 6px 10px 10px;box-shadow:6px 6px 0 var(--ink);transition:transform 220ms cubic-bezier(.34,1.7,.5,1),box-shadow 220ms}
.sleeve::before{content:"";position:absolute;left:50%;top:-2px;width:46px;height:12px;translate:-50% 0;background:#07060f;opacity:.3;border-radius:0 0 24px 24px}
.tag{font:700 9px/1.2 var(--mono);letter-spacing:1px}
.skel{display:grid;gap:5px}
.skel i{display:block;width:var(--w);height:6px;border-radius:3px;background:#07060f38}
.more{justify-self:end;font:700 10px/1 var(--mono);letter-spacing:1px;padding:4px 7px;background:#07060f;color:#f4457a;border-radius:4px}
@media (hover:hover) and (pointer:fine){.sleeve:hover{transform:translate(-2px,-2px);box-shadow:8px 8px 0 var(--ink)}}
.sleeve:active{transform:translate(4px,4px);box-shadow:1px 1px 0 var(--ink);transition-duration:60ms}
.sleeve:focus-visible{outline:3px solid var(--ink);outline-offset:4px}
@media (max-width:420px){.cartridge{min-height:220px;padding:0 9px}strong{font-size:15px}.sleeve{padding:10px 11px 8px;gap:5px}.tag{font-size:7px;letter-spacing:.3px}.skel i:nth-child(3){display:none}}
</style>
