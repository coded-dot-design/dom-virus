---
// A board game's page on the hub (Battlefield Blitz): the game runs full screen on its own site, so
// Play links there. Copy is the engine page JSON (spec → `fe brief` → `abe produce`); the card data
// (kind, tagline, accent) is the content model's.
import UiIcon from './UiIcon.astro';
import GameGuide from './GameGuide.astro';
import { SHOTS } from '../shots';
const { content, game, base = '/' } = Astro.props;
const hero = content.sections.find((s) => s.type === 'hero');
const figure = content.sections.find((s) => s.type === 'mediaFigure' && s.eyebrow === 'SCREENSHOT');
const shot = figure ? SHOTS[figure.image.src.replace(/^\/shots\//, '')] : undefined;
const [num, kind] = (hero.eyebrow || '').split(' / ');
---
<section id={game.id} class:list={['game-section', 'standalone', 'board-page', `accent-${game.accent}`]} aria-labelledby={`${game.id}-title`}>
  <a class="back-link" href={`${base}games/`} data-virus-ignore data-swarm-ignore><span class="eject-key" aria-hidden="true"><UiIcon name="eject" size={16}/></span> Every game</a>
  <div class="section-heading"><span class="eyebrow"><span class="index">{num}</span> {kind || game.kind}</span><span class="version">{game.players === '1' ? '1 PLAYER' : `${game.players} PLAYERS`} / MIT</span></div>
  <div class="game-intro">
    <div>
      <h1 id={`${game.id}-title`}>{hero.heading}<span>{hero.headingAccent}</span></h1>
      <p class="lead">{hero.body}</p>
      <div class="actions" data-virus-ignore data-swarm-ignore>{hero.ctas.map((c, i) => <a class:list={['button', i === 0 ? 'primary' : 'quiet']} href={c.href}><UiIcon name="play" size={18}/> {c.label}</a>)}</div>
      <p class="credit">Created by <a href="https://coded.design/" rel="author">Chris Cooley</a> · <a href="https://coded.design">coded.design</a> · <a href={`${game.repo}#readme`}>Source on GitHub</a></p>
    </div>
    {figure && <figure class="board-shot card"><img src={base + figure.image.src.slice(1)} alt={figure.image.alt} width={shot?.[0]} height={shot?.[1]} fetchpriority="high" decoding="async"/></figure>}
  </div>
  <GameGuide content={content} base={base} id={game.id} poster={false}/>
</section>
<style>
.board-shot{margin:0;padding:0;overflow:hidden;align-self:center}
.board-shot img{display:block;width:100%;height:auto}
</style>
