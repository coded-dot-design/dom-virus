---
import PromoCharacter from './PromoCharacter.astro';
import Character from './AbstractIcon.astro';
import UiIcon from './UiIcon.astro';
import MotionToggle from './MotionToggle.astro';
import PixelTank from './PixelTank.astro';
import { FOES, PLANE, TANK, SKULL, aimStart, foeColor } from '../hero-data';
/*
  Hero mash-up. This markup is the still poster (what reduced motion and a page without scripts
  show): the bad guys in place and both shooters on the card. The scene (hero-scene.ts, on Fizlet,
  mounted by fizlet/slot from client.ts) plays the intro and the 8 s loop over these same elements,
  and the first tap turns it into the mini-game. Until the scene is up, motion-allowed visitors see
  the empty card the intro starts from.
*/
---
<div data-byte-obstacle class="hero-art hero-crossover" role="group" aria-label="DOM Virus skulls and bad guys from every game spawn into a browser window; a tank and an interceptor arrive and blast them.">
  <div class="code-chrome"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>your.page / under attack</span><MotionToggle label="scene"/></div>
  <p class="try-me" data-try-me role="status" hidden><svg aria-hidden="true" viewBox="0 0 64 64" shape-rendering="crispEdges"><path fill-rule="evenodd" d={SKULL}/></svg>Psst. Tap the bad guys. Drag the tank. Hit <span>BUTTON_01</span>.</p>
  <div class="promo-stage promo-motion">
    <div class="promo-page"><div class="promo-title">HELLO,<br/><span>WORL<span class="binary">01</span></span></div><div class="promo-lines" aria-hidden="true"><i></i><i></i></div><button class="art-button promo-button" data-arcade-target data-virus-target data-swarm-target>BUTTON_01 <UiIcon name="arrow-up-right" size={14}/></button></div>
    <svg class="promo-action" viewBox="0 0 500 360" fill="none" aria-hidden="true">
      {FOES.map((f) => (
        <g transform={`translate(${f.x} ${f.y})`} class="foe-css" data-size={f.size} data-color={foeColor(f)}>
          <circle class="promo-motion spawn-ring" r={f.size * 0.45} stroke={foeColor(f)} stroke-width="3"/>
          <g class="promo-motion spawn"><g class="promo-motion die"><g class="promo-motion idle">
            <g class="foe-art" transform={`translate(${-f.size / 2} ${-f.size / 2})`}>
              {f.art === 'skull' ? (
                <svg class="promo-character foe-skull" width={f.size} height={f.size} viewBox="0 0 64 64" shape-rendering="crispEdges"><path fill-rule="evenodd" d={SKULL} fill={f.color}/></svg>
              ) : f.art === 'alien' || f.art === 'bug' ? (
                <PromoCharacter kind={f.art} size={f.size} color={f.color}/>
              ) : (
                <Character kind={f.art} size={f.size}/>
              )}
            </g>
          </g></g></g>
        </g>
      ))}
      <g transform={`translate(${PLANE.x} ${PLANE.y})`}>
        <g class="promo-motion plane-in">
          <g class="promo-motion plane-aim" style={`transform:rotate(${aimStart('plane').toFixed(1)}deg)`}>
            <g class="promo-motion plane-kick">
              <rect x="-48" y="-48" width="96" height="96" fill="none"/>
              <g transform="translate(-48 -48)"><PromoCharacter kind="ship" size={96} color="#06c4ff"/></g>
            </g>
          </g>
        </g>
      </g>
      <g transform={`translate(${TANK.x} ${TANK.y})`}>
        <g class="promo-motion tank-in">
          <g class="promo-motion tank-rumble">
            <PixelTank turretClass="promo-motion turret-aim" turretStyle={`transform:rotate(${aimStart('tank').toFixed(1)}deg)`} kickClass="promo-motion turret-kick"/>
          </g>
        </g>
      </g>
    </svg>
    <div class="promo-status"><span class="led"></span> SAME PAGE. DIFFERENT RULES. TAP TO PLAY</div>
  </div>
</div>
<style>
.hero-crossover{width:calc(100% - 48px);margin:42px 24px 24px;overflow:visible;isolation:isolate;transform:rotate(-2deg)}
/* "Try me" bubble: shows only if someone lingers without touching the card (client.ts). */
.try-me{position:absolute;z-index:6;top:-22px;right:18px;max-width:min(270px,70%);margin:0;padding:9px 12px 9px 34px;font:600 11px/1.35 var(--mono);color:var(--ink);background:var(--surface);border:2px solid var(--ink);border-radius:10px;box-shadow:3px 3px 0 var(--ink);rotate:3deg;pointer-events:none;opacity:0;translate:0 8px;transition:opacity .25s ease,translate .3s cubic-bezier(.2,.8,.2,1)}
.try-me:global(.show){opacity:1;translate:0 0}
.try-me span{color:var(--accent-text,var(--accent))}
.try-me svg{position:absolute;left:10px;top:50%;width:16px;height:16px;margin-top:-8px;fill:#f4457a}
.try-me::after{content:"";position:absolute;left:26px;bottom:-9px;width:14px;height:14px;background:var(--surface);border-right:2px solid var(--ink);border-bottom:2px solid var(--ink);rotate:45deg}
.hero-crossover .code-chrome{padding:9px 14px;min-height:44px}.hero-crossover .code-chrome>:nth-child(2){margin-inline:auto;font-size:9px}
.promo-stage{position:relative;aspect-ratio:500/360;container-type:inline-size;cursor:pointer}.promo-page{position:absolute;inset:0;padding:12% 10%}
.promo-title{font:700 10cqw/1.08 var(--mono);letter-spacing:-.5cqw;color:var(--ink)}.promo-title>span{color:var(--faint)}.promo-title .binary{color:var(--accent-text,var(--accent));display:inline-block;transform:rotate(-7deg)}
.promo-lines{margin-top:5%}.promo-lines i{height:1cqw;width:40%;background:var(--line);margin:1.6cqw 0}.promo-lines i:last-child{width:29%}
/* The mock button is a real 3D button (site press rule: 3px base, hover lifts, press lands on
   the base) and clicking it nukes every bad guy and resets the round. */
.hero-crossover .promo-button{position:relative;margin-top:8%;font-size:clamp(7px,2cqw,10px);min-height:30px;padding:2.4% 3.5%;gap:3cqw;z-index:2;background:var(--raised);color:var(--ink);border-color:var(--ink);box-shadow:3px 3px 0 var(--ink);cursor:pointer}
.promo-action{position:absolute;inset:0;width:100%;height:100%;overflow:visible;pointer-events:none;z-index:3}.promo-status{position:absolute;bottom:14px;right:16px;display:flex;align-items:center;gap:7px;font:8px var(--mono);color:var(--faint)}
/* The scene moves these on their own centre (it also adds shots and blasts, hence :global). */
.hero-crossover :global(:is(.promo-motion,.tank-hull)){transform-box:fill-box;transform-origin:center}
.spawn-ring{opacity:0}
/* Motion allowed: the card waits empty (the intro's first frame) until the scene is up. */
@media(prefers-reduced-motion:no-preference){.promo-stage:not(:has(>:global([data-fizlet-slot]))) .promo-action{visibility:hidden}}
/* Mini-game (the scene's play mode). The alarm blink and the nuke flash are plain CSS. */
.hero-crossover:global([data-play="true"]) .promo-stage{touch-action:pan-y;cursor:crosshair;user-select:none;-webkit-user-select:none}
.hero-crossover:global(.hx-alarm){animation:hx-alarm .5s steps(2) infinite}
.hero-crossover:global(.hx-alarm) .promo-status{color:#f4457a;font-weight:700}
@keyframes hx-alarm{50%{box-shadow:0 0 0 3px #f4457a,0 0 40px #f4457a88}}
.hero-crossover:global(.hx-nuke) .promo-stage::after{content:"";position:absolute;inset:0;z-index:5;pointer-events:none;background:#fff4ff;animation:hx-nuke 1.4s ease-out forwards}
@keyframes hx-nuke{0%{opacity:0}8%{opacity:.95}100%{opacity:0}}
@media(max-width:760px){.hero-crossover{max-width:470px;width:calc(100% - 40px);margin:10px auto 24px}.promo-status{font-size:6px;bottom:10px;right:10px}}
</style>
