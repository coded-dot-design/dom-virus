---
// DOM Kaiju (coming soon): the plan, the cast and the palette. Play is disabled until it ships.
// Plan of record: docs/games/dom-kaiju.md.
import UiIcon from './UiIcon.astro';
import kaijuIcon from '../assets/kaiju-icon.svg?raw';
import { SOON_GAMES } from '../coming-soon';
const { base = '/' } = Astro.props;
const game = SOON_GAMES.find((g) => g.id === 'kaiju');
const run = [
  ['DROP-IN', 'GLITCH smashes down through the header and rides the page all the way to the footer. The page scrolls with him.'],
  ['CLIMB', 'Up the sides of headings, paragraphs, cards and buttons. Jump between them. Punch handholds into white space.'],
  ['SMASH', 'Text cracks, shatters into glyph shards and catches fire. Cards crumble, buttons pop off and become weapons.'],
  ['SURVIVE', 'Chopper swarms strafe him. Live-wire text zaps him back to the bottom. Fire hurts. Rage builds to a ROAR.'],
  ['TOP', 'Grab the top of the page, beat your chest on the logo. Score: height, WRECKED %, choppers, people saved.'],
  ['RECALL', 'The page heals: every crack, hole, burn and missing letter comes back exactly as it was.'],
];
const cast = [
  { name: 'GLITCH', role: 'You: a giant pixel gorilla', color: '#3b2a6b', accent: '#ff2e88' },
  { name: 'Choppers', role: 'Swarms that strafe; swat, grab, throw', color: '#06c4ff', accent: '#ffc21a' },
  { name: 'Gunship', role: 'Mini-boss every few screens: rockets', color: '#1d6fa3', accent: '#ffc21a' },
  { name: 'Live wires', role: 'Electrified text and cards: ZAP, you fall', color: '#19f0ff', accent: '#e8fbff' },
  { name: 'Fire', role: 'Crawls along smashed lines letter by letter', color: '#ff8a1f', accent: '#ffe14d' },
  { name: 'People', role: 'Fall out of smashed cards: catch them', color: '#ffd1dc', accent: '#b8f2e6' },
];
const palette = [
  ['Fur', '#3b2a6b'], ['Chest + fists', '#ff2e88'], ['Eyes', '#ffe14d'], ['Choppers', '#06c4ff'], ['Tracers', '#ffc21a'],
  ['Fire', '#ff8a1f'], ['Electricity', '#19f0ff'], ['Rubble', '#aea4d6'],
];
const facts = [
  { value: '2', label: 'builds: embed and full board' },
  { value: '1', label: 'page = one level, any page' },
  { value: '≥55', small: 'fps', label: 'target with 20 choppers + fire' },
  { value: '≤30', small: 'kB', label: 'gzip target for the embed' },
];
---
<section id="kaiju" class="game-section standalone kaiju-page" aria-labelledby="kaiju-title">
  <a class="back-link" href={`${base}games/coming-soon/`}><span class="eject-key" aria-hidden="true"><UiIcon name="arrow-up-right" size={16}/></span> All coming soon</a>
  <div class="section-heading"><span class="eyebrow"><span class="index">{game.n}</span> {game.kind}<span class="eyebrow-extra"> / COMING SOON</span></span><span class="version">PLANNED / MIT</span></div>
  <div class="game-intro">
    <div>
      <h1 id="kaiju-title">DOM Kaiju<span>Climb the page. Wreck the page.</span></h1>
      <p class="lead">{game.line} Text catches fire, people fall, choppers swarm in shooting, and live wires in the copy zap you all the way back to the bottom. The engine's first big test: one embed build for any page, one full board.</p>
      <div class="actions">
        <span class="button primary soon-key" aria-disabled="true"><UiIcon name="clock" size={18}/> Coming soon</span>
        <a class="button" href={game.doc}><UiIcon name="github" size={18}/> Design notes</a>
      </div>
      <p class="soon-note"><i aria-hidden="true"></i><b>Build order</b> After Battlefield Blitz and DOM Crossfire.</p>
    </div>
    <div data-byte-obstacle class="game-display kaiju-display" style="view-transition-name: game-screen" role="img" aria-label="Concept: GLITCH the pixel gorilla climbs a page of text while helicopters fire at him and a line of text burns">
      <div class="display-top"><span class="led"></span> CLIMB + SMASH<span class="display-note">CONCEPT / NOT FINAL</span></div>
      <div class="city">
        <div class="blk h"><i></i><i class="short"></i></div>
        <div class="blk p"><i></i><i class="burn"></i><i></i><i class="short"></i></div>
        <div class="blk card live"><i></i><i class="short"></i></div>
        <div class="blk p two"><i></i><i></i><i class="short"></i></div>
        <span class="hole" aria-hidden="true"></span>
        <span class="ape" aria-hidden="true"><Fragment set:html={kaijuIcon}/></span>
        <span class="chopper c1" aria-hidden="true"><b></b><s></s></span>
        <span class="chopper c2" aria-hidden="true"><b></b><s></s></span>
        <span class="tracer t1"></span><span class="tracer t2"></span>
        <span class="person" aria-hidden="true"></span>
        <span class="pow" aria-hidden="true">SMASH!</span>
      </div>
      <div class="display-bottom"><span>Footer to header.</span><span>DON'T TOUCH THE LIVE WIRES</span></div>
    </div>
  </div>
  <div class="game-facts">{facts.map((f) => <div><b>{f.value}{f.small && <small> {f.small}</small>}</b><span>{f.label}</span></div>)}</div>

  <div class="kj-block">
    <div class="eyebrow">THE RUN</div>
    <h2>One page. One climb.</h2>
    <ol class="kj-run">{run.map(([t, b], i) => <li class="card"><span class="tag">{String(i + 1).padStart(2, '0')}</span><div><h3>{t}</h3><p>{b}</p></div></li>)}</ol>
  </div>

  <div class="kj-block">
    <div class="eyebrow">THE CAST</div>
    <h2>Who's on the page.</h2>
    <ul class="kj-cast">{cast.map((c) => <li class="card"><span class="sw" style={`--a:${c.color};--b:${c.accent}`}></span><div><h3>{c.name}</h3><p>{c.role}</p></div></li>)}</ul>
  </div>

  <div class="kj-block">
    <div class="eyebrow">PALETTE</div>
    <h2>Neon on ink, like Battlefield.</h2>
    <ul class="kj-palette">{palette.map(([n, hex]) => <li><i style={`background:${hex}`}></i><b>{n}</b><code>{hex}</code></li>)}</ul>
  </div>

  <a class="nerd-link card" href={game.doc}><span class="eyebrow">DESIGN DOC · GITHUB</span><strong>DOM Kaiju: the full plan</strong><span>Movement, smashing, enemies, controls, characters, the two builds, the engine test plan and milestones</span><UiIcon name="github" size={20}/></a>
</section>
<script>import "../loops/kaiju";</script>
<style>
.soon-note{display:flex;align-items:center;flex-wrap:wrap;gap:4px 10px;width:fit-content;margin:18px 0 0;padding:8px 12px;font:600 11px/1.4 var(--mono);color:var(--ink);background:color-mix(in srgb,var(--accent) 14%,var(--surface));border:2px solid var(--ink);border-radius:8px}
.soon-note i{width:8px;height:8px;border-radius:2px;background:var(--accent);box-shadow:0 0 0 1px var(--ink);animation:soon-blink 1s steps(2) infinite}
.soon-note b{letter-spacing:.08em;text-transform:uppercase;color:var(--accent-text,var(--accent))}
@keyframes soon-blink{50%{opacity:.3}}
@media (prefers-reduced-motion:reduce){.soon-note i{animation:none}}
.soon-key{cursor:not-allowed;opacity:.85}
.kaiju-display{overflow:hidden}
.city{position:relative;height:260px;margin:6px 18px;background:linear-gradient(#06c4ff12 1px,transparent 1px) 0 0/24px 24px,linear-gradient(90deg,#06c4ff12 1px,transparent 1px) 0 0/24px 24px}
.blk{position:absolute;display:grid;gap:7px;padding:10px;background:#1a1430;border:2px solid #3c2b55;border-radius:6px}
.blk i{display:block;height:6px;background:#aea4d6;opacity:.55;border-radius:2px}
.blk i.short{width:60%}
.blk.h{left:44%;top:14px;width:44%}.blk.h i{height:10px;opacity:.9;background:#f6f3ff}
.blk.p{left:8%;top:62px;width:36%}
.blk.card{left:52%;top:96px;width:38%}
.blk.p.two{left:14%;top:176px;width:40%}
.blk.live{border-color:#19f0ff;box-shadow:0 0 0 2px #19f0ff44,0 0 18px #19f0ff66}
.blk i.burn{background:linear-gradient(90deg,#ff8a1f,#ffe14d,#ff2e88);opacity:1}
.hole{position:absolute;left:47%;top:150px;width:22px;height:18px;background:#07060f;clip-path:polygon(10% 20%,40% 0,60% 25%,100% 10%,85% 60%,100% 100%,50% 80%,0 100%,15% 55%)}
.ape{position:absolute;left:40%;top:118px;width:58px;height:62px}
.ape :global(svg){width:100%;height:100%}
.chopper{position:absolute;width:30px;height:14px}
.chopper b{position:absolute;left:4px;top:5px;width:18px;height:9px;background:#06c4ff;border:2px solid #07060f;border-radius:4px 8px 6px 4px}
.chopper b::after{content:"";position:absolute;right:-12px;top:2px;width:12px;height:3px;background:#06c4ff}
.chopper s{position:absolute;left:-4px;top:0;width:34px;height:3px;background:#e8fbff;opacity:.8}
.c1{right:8%;top:58px}.c2{right:22%;top:200px}
.tracer{position:absolute;height:3px;width:26px;background:#ffc21a;box-shadow:0 0 8px #ffc21a;opacity:0}
.t1{right:16%;top:66px;rotate:20deg}.t2{right:30%;top:200px;rotate:-25deg}
.person{position:absolute;left:58%;top:150px;width:5px;height:9px;background:#ffd1dc;box-shadow:0 -4px 0 -1px #ffe5a8}
.pow{position:absolute;left:30%;top:96px;padding:4px 8px;font:900 14px var(--mono);color:#07060f;background:#ffe14d;border:2px solid #07060f;rotate:-8deg;opacity:0}
/* The scene's motion runs on Fizlet (loops/kaiju.ts): it sleeps off screen and in hidden tabs;
   under reduced motion this CSS is the still frame. */
.kj-block{margin-top:42px}
.kj-block h2{margin:8px 0 18px;font-size:22px}
h3{margin:0 0 6px;font-size:16px;line-height:inherit;letter-spacing:inherit}
.kj-run{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
.kj-run li,.kj-cast li{display:grid;grid-template-columns:auto 1fr;gap:14px;padding:18px}
.kj-run p,.kj-cast p{margin:0;font-size:13px;line-height:1.6;color:var(--muted)}
.tag{align-self:start;padding:4px 8px;font:700 10px var(--mono);letter-spacing:1px;color:var(--accent-ink);background:var(--accent);border:2px solid var(--ink);border-radius:4px}
.kj-cast{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
.sw{width:42px;height:42px;border:2px solid var(--ink);border-radius:8px;background:linear-gradient(135deg,var(--a) 0 60%,var(--b) 60%)}
.kj-palette{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px}
.kj-palette li{display:grid;grid-template-columns:36px 1fr;grid-template-areas:"sw name" "sw hex";column-gap:10px;font-size:13px}
.kj-palette i{grid-area:sw;width:36px;height:36px;border:2px solid var(--ink);border-radius:8px}
.kj-palette b{grid-area:name}.kj-palette code{grid-area:hex;font-size:11px;color:var(--muted)}
.kaiju-page > .nerd-link{margin-top:42px}
@media (max-width:860px){.kj-run,.kj-cast{grid-template-columns:minmax(0,1fr)}}
</style>
