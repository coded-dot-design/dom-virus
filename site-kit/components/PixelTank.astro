---
// Abstract pixel tank shared by the hero and the Battlefield scene. Facing right; the turret
// rotates on the hull centre. Structure is relied on by hero-game.ts: `.tank-hull path` (tread
// marks) and the turret's first child (recoil group).
const {
  body = '#2f9a5e',
  tread = '#1d6a40',
  top = '#5ff09a',
  ink = '#123d27',
  turretClass = '',
  turretStyle = undefined,
  kickClass = '',
  kickStyle = undefined,
} = Astro.props;
---
<g class="tank-hull" fill={body} shape-rendering="crispEdges">
  <rect x="-42" y="-36" width="84" height="20"/>
  <rect x="-42" y="16" width="84" height="20"/>
  <rect x="-30" y="-24" width="54" height="48"/>
  <path d="M-38 -30h6v8h-6zm14 0h6v8h-6zm14 0h6v8h-6zm14 0h6v8h-6zm14 0h6v8h-6zM-38 22h6v8h-6zm14 0h6v8h-6zm14 0h6v8h-6zm14 0h6v8h-6zm14 0h6v8h-6z" fill={tread}/>
</g>
<g class:list={['tank-turret', turretClass]} style={turretStyle}>
  <g class={kickClass || undefined} style={kickStyle}>
    <rect x="-60" y="-60" width="120" height="120" fill="none"/>
    <g shape-rendering="crispEdges">
      <rect x="10" y="-6" width="46" height="12" fill={top} stroke={ink} stroke-width="2"/>
      <rect x="50" y="-8" width="8" height="16" fill={ink}/>
      <rect x="-19" y="-18" width="38" height="36" fill={top} stroke={ink} stroke-width="2"/>
      <rect x="-9" y="-8" width="18" height="16" fill={ink}/>
    </g>
  </g>
</g>
