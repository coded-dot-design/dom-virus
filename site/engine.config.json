{
  "$comment": "astro-base-engine config for the DOM VIRUS hub. Run the engine with --site site (the Astro srcDir is site/src, so page JSON lands in site/src/content/pages). brand.siteUrl is the live GitHub Pages address until domvirus.com is pointed (then change it here; family.json has the production URL). Rules: brand/README.md; decisions: brand/DECISIONS.md. Routes and page types: brand/SITEMAP.md. Produce with `python3 scripts/abe.py produce <brief> --site site --write`.",
  "brand": {
    "name": "DOM VIRUS",
    "siteUrl": "https://coded-dot-design.github.io/dom-virus",
    "defaultImage": "https://coded-dot-design.github.io/dom-virus/og/dom-virus.png",
    "author": {
      "name": "Chris Cooley",
      "url": "https://coded.design/"
    }
  },
  "inputs": {
    "voice": "../brand/voice.md",
    "styleGuide": "../brand/style-guide.md"
  },
  "pageTypes": {
    "home": {
      "template": "marketing",
      "path": "/",
      "eyebrow": "",
      "schemaPageType": "WebPage",
      "requires": [
        "hero"
      ]
    },
    "section": {
      "template": "marketing",
      "path": "/{slug}",
      "eyebrow": "",
      "schemaPageType": "CollectionPage",
      "requires": [
        "hero"
      ]
    },
    "games-section": {
      "template": "marketing",
      "path": "/games/{slug}",
      "eyebrow": "Games",
      "schemaPageType": "CollectionPage",
      "requires": [
        "hero"
      ]
    },
    "embedded": {
      "template": "marketing",
      "path": "/games/{slug}",
      "eyebrow": "Embedded game",
      "schemaPageType": "VideoGame",
      "requires": [
        "hero"
      ]
    },
    "engine": {
      "template": "marketing",
      "path": "/engine/{slug}",
      "eyebrow": "Engine",
      "schemaPageType": "TechArticle",
      "requires": [
        "hero"
      ]
    },
    "about": {
      "template": "marketing",
      "path": "/about/{slug}",
      "eyebrow": "About",
      "schemaPageType": "AboutPage",
      "requires": [
        "hero"
      ]
    },
    "about-home": {
      "template": "article",
      "path": "/about",
      "eyebrow": "About",
      "schemaPageType": "AboutPage",
      "requires": [
        "hero"
      ]
    },
    "contact": {
      "template": "marketing",
      "path": "/contact",
      "eyebrow": "Contact",
      "schemaPageType": "ContactPage",
      "requires": [
        "hero"
      ]
    },
    "support": {
      "template": "marketing",
      "path": "/support",
      "eyebrow": "Support",
      "schemaPageType": "WebPage",
      "requires": [
        "hero"
      ]
    },
    "legal": {
      "template": "article",
      "path": "/legal/{slug}",
      "eyebrow": "Legal",
      "schemaPageType": "WebPage",
      "requires": [
        "hero"
      ]
    },
    "legal-home": {
      "template": "marketing",
      "path": "/legal",
      "eyebrow": "Legal",
      "schemaPageType": "CollectionPage",
      "requires": [
        "hero"
      ]
    },
    "blog": {
      "template": "article",
      "path": "/blog/{slug}",
      "eyebrow": "Blog",
      "schemaPageType": "BlogPosting",
      "related": true
    },
    "news": {
      "template": "article",
      "path": "/news/{slug}",
      "eyebrow": "News",
      "schemaPageType": "NewsArticle",
      "related": true
    }
  },
  "knownRoutes": [
    "/",
    "/engine/",
    "/about/brand/",
    "/about/brand/archive/",
    "/feed.xml",
    "/battlefield/",
    "/games/*"
  ]
}
