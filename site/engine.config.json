{
  "$comment": "astro-base-engine config for the DOM VIRUS hub. Run the engine with --site site (the Astro srcDir is site/src, so page JSON lands in site/src/content/pages). brand.siteUrl is the GitHub Pages address; targets.production points the same pages at https://domvirus.com (heads for both are generated by npm run engine:heads; the build picks the one that matches its own URL). Rules: brand/README.md; decisions: brand/DECISIONS.md. Routes and page types: brand/SITEMAP.md. Produce with `python3 scripts/abe.py produce <brief> --site site --write`.",
  "brand": {
    "name": "DOM VIRUS",
    "siteUrl": "https://coded-dot-design.github.io/dom-virus",
    "defaultImage": "/og/dom-virus.png",
    "author": {
      "name": "Chris Cooley",
      "url": "https://coded.design/"
    }
  },
  "targets": {
    "staging": {
      "brand": {
        "siteUrl": "https://coded-dot-design.github.io/dom-virus"
      }
    },
    "production": {
      "brand": {
        "siteUrl": "https://domvirus.com"
      }
    }
  },
  "inputs": {
    "voice": "../brand/voice.md",
    "styleGuide": "../brand/style-guide.md"
  },
  "pageTypes": {
    "home": {
      "template": "marketing",
      "path": "/",
      "eyebrow": "",
      "schemaPageType": "WebPage",
      "requires": [
        "hero"
      ]
    },
    "section": {
      "template": "marketing",
      "path": "/{slug}",
      "eyebrow": "",
      "schemaPageType": "CollectionPage",
      "requires": [
        "hero"
      ]
    },
    "games-section": {
      "template": "marketing",
      "path": "/games/{slug}",
      "eyebrow": "Games",
      "schemaPageType": "CollectionPage",
      "requires": [
        "hero"
      ]
    },
    "game": {
      "template": "marketing",
      "path": "/games/{slug}",
      "eyebrow": "Embedded game",
      "schemaPageType": "VideoGame",
      "schemaNameFromHeading": true,
      "schemaDefaults": {
        "gamePlatform": "Web browser",
        "applicationCategory": "Game",
        "isAccessibleForFree": true
      },
      "schemaFields": [
        "codeRepository"
      ],
      "requires": [
        "hero"
      ],
      "siteSlots": {
        "required": [
          "play",
          "loop",
          "controls",
          "facts"
        ],
        "optional": [
          "characters",
          "palette",
          "related",
          "embed"
        ]
      }
    },
    "engine": {
      "template": "marketing",
      "path": "/engine/{slug}",
      "eyebrow": "Engine",
      "schemaPageType": "TechArticle",
      "requires": [
        "hero"
      ]
    },
    "about": {
      "template": "marketing",
      "path": "/about/{slug}",
      "eyebrow": "About",
      "schemaPageType": "AboutPage",
      "requires": [
        "hero"
      ]
    },
    "about-home": {
      "template": "article",
      "path": "/about",
      "eyebrow": "About",
      "schemaPageType": "AboutPage",
      "requires": [
        "hero"
      ]
    },
    "contact": {
      "template": "marketing",
      "path": "/contact",
      "eyebrow": "Contact",
      "schemaPageType": "ContactPage",
      "requires": [
        "hero"
      ]
    },
    "support": {
      "template": "marketing",
      "path": "/support",
      "eyebrow": "Support",
      "schemaPageType": "WebPage",
      "requires": [
        "hero"
      ]
    },
    "legal": {
      "template": "article",
      "path": "/legal/{slug}",
      "eyebrow": "Legal",
      "schemaPageType": "WebPage",
      "requires": [
        "hero"
      ]
    },
    "legal-home": {
      "template": "marketing",
      "path": "/legal",
      "eyebrow": "Legal",
      "schemaPageType": "CollectionPage",
      "requires": [
        "hero"
      ]
    },
    "blog": {
      "template": "article",
      "path": "/blog/{slug}",
      "eyebrow": "Blog",
      "schemaPageType": "BlogPosting",
      "related": true
    },
    "news": {
      "template": "article",
      "path": "/news/{slug}",
      "eyebrow": "News",
      "schemaPageType": "NewsArticle",
      "related": true
    }
  },
  "knownRoutes": [
    "/",
    "/engine/",
    "/about/brand/",
    "/about/brand/archive/",
    "/feed.xml",
    "/battlefield/",
    "/games/*",
    "/board-ui/",
    "/404.html",
    "/sitemap.xml",
    "/robots.txt",
    "/llms.txt",
    "/humans.txt",
    "/.well-known/security.txt",
    "/CNAME"
  ],
  "sitemap": {
    "$comment": "Site-owned indexable routes (not engine pages) for the production sitemap.xml from `abe site-files`. The build fails if an indexable built page is missing from the sitemap or a sitemap URL is not built.",
    "extra": [
      "/",
      "/engine/",
      "/about/brand/",
      "/about/brand/archive/",
      "/battlefield/",
      "/games/battlefield/",
      "/games/byte-runner/",
      "/games/coming-soon/",
      "/games/kaiju/",
      "/games/null-invaders/",
      "/games/swarm-protocol/"
    ]
  }
}
