{
  "$comment": "astro-base-engine config for the DOM VIRUS hub. Run the engine with --site site (the Astro srcDir is site/src, so page JSON lands in site/src/content/pages). brand.siteUrl is the live GitHub Pages address until domvirus.com is pointed (then change it here; family.json has the production URL). Rules: brand/README.md; decisions: brand/DECISIONS.md.",
  "brand": {
    "name": "DOM VIRUS",
    "siteUrl": "https://coded-dot-design.github.io/dom-virus",
    "defaultImage": "/og/dom-virus.png"
  },
  "inputs": { "voice": "../brand/voice.md", "styleGuide": "../brand/style-guide.md" },
  "pageTypes": {
    "home":        { "template": "marketing", "path": "/",                   "eyebrow": "",               "schemaPageType": "WebPage",     "requires": ["hero"] },
    "coming-soon": { "template": "marketing", "path": "/coming-soon/{slug}", "eyebrow": "Coming soon",    "schemaPageType": "WebPage",     "requires": ["hero", "featureList"] },
    "embedded":    { "template": "marketing", "path": "/games/{slug}",       "eyebrow": "Embedded game",  "schemaPageType": "VideoGame",   "requires": ["hero"] },
    "blog":        { "template": "article",   "path": "/blog/{slug}",        "eyebrow": "Blog",           "schemaPageType": "BlogPosting", "related": true },
    "news":        { "template": "article",   "path": "/news/{slug}",        "eyebrow": "News",           "schemaPageType": "NewsArticle", "related": true },
    "campaign":    { "template": "marketing", "path": "/{slug}",             "eyebrow": "",               "schemaPageType": "WebPage",     "requires": ["hero"] },
    "style-guide": { "template": "marketing", "path": "/style-guide/{slug}", "eyebrow": "Style guide",    "schemaPageType": "WebPage",     "requires": ["hero"] }
  }
}
