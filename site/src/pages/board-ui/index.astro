---
// Board UI moved to DOM Battlefield's own site; old links land there.
const to = 'https://coded-dot-design.github.io/dom-battlefield/style-guide/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Board UI moved</title>
    <meta name="description" content="Board UI moved to the DOM Battlefield site. You are being sent to its style guide." />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
  </head>
  <body>
    <main><h1>Board UI moved</h1><p>Board UI now lives on the DOM Battlefield site: <a href={to}>{to}</a></p></main>
  </body>
</html>
