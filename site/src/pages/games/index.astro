---
// /games/ is the parent in every game page's breadcrumb (astro-base-engine JSON-LD). The games live on
// the home console, so this URL sends people there instead of returning a 404.
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const to = `${base}#games`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Games — DOM VIRUS</title>
  <meta name="description" content="Every DOM VIRUS game lives on the home console. Pick a cartridge and play it on the page."/>
  <meta name="robots" content="noindex,follow"/>
  <link rel="canonical" href={new URL(base, Astro.site).href}/>
  <meta http-equiv="refresh" content={`0; url=${to}`}/>
</head>
<body>
  <main><h1>Games</h1><p><a href={to}>Choose a game on the DOM VIRUS console</a></p></main>
</body>
</html>
