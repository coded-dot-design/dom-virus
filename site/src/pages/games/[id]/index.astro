---
import Site from '@site-kit/components/Site.astro';
import data from '@site-data';
import { SOON_GAMES } from '@site-kit/coming-soon';
import { gameShown } from '@site-kit/lifecycle.mjs';
import { boardRoutes, byRoute } from '@site-kit/catalog';
export function getStaticPaths() {
  // Playable games, plus the detail page of a coming-soon game where this build shows it
  // (DOM Kaiju: staging only until its model status is published; site-kit/lifecycle.mjs).
  const soon = SOON_GAMES.filter((g) => g.page === `games/${g.id}/` && gameShown(g.id)).map((g) => ({ params: { id: g.id }, props: { soon: g.id } }));
  // Board games that play on their own site get a hub page from their engine page (Battlefield Blitz).
  const boards = boardRoutes().map((g) => ({ params: { id: g.route.split('/')[1] }, props: { board: g.route.split('/')[1] } }));
  return [...data.games.map((game) => ({ params: { id: game.id } })), ...soon, ...boards];
}
const { id } = Astro.params;
const { soon, board } = Astro.props;
---
{soon ? <Site data={data} page={soon} /> : board ? <Site data={data} page="board" engineId={`games-${board}`} boardGame={byRoute(board)} /> : <Site data={data} page="game" gameId={id} />}

<script>import "@site-kit/client.ts";</script>
