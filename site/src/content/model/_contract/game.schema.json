{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brain-cache/fizlet-engine/spec/game.schema.json",
  "title": "Fizlet game spec",
  "description": "One file per game (games/<id>/spec.json): the single source the factory turns into the game repo scaffold, the site data (site/game.json), the family row and the astro-base-engine page brief. Facts only; measured numbers come from the build, not from here.",
  "type": "object",
  "required": ["id", "name", "number", "tag", "type", "status", "brand", "repo", "engine", "budget", "site"],
  "additionalProperties": false,
  "$defs": {
    "link": { "type": "object", "required": ["label", "href"], "additionalProperties": false, "properties": { "label": { "type": "string", "maxLength": 80 }, "href": { "type": "string", "pattern": "^(https://|/|#)" } } },
    "items": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": { "type": "object", "required": ["title", "body"], "additionalProperties": false, "properties": { "title": { "type": "string", "minLength": 2, "maxLength": 120, "pattern": "^[^|]*$" }, "body": { "type": "string", "minLength": 10, "maxLength": 600, "pattern": "^[^|]*$" } } }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$", "description": "Repo name and URL slug." },
    "name": { "type": "string", "minLength": 2, "maxLength": 40 },
    "number": { "type": "string", "pattern": "^[0-9]{2}$", "description": "Shelf number, from the roster." },
    "tag": { "type": "string", "pattern": "^[A-Z0-9 +]+$", "description": "Gameplay tag, e.g. DOM TANK." },
    "type": { "enum": ["embedded", "board"] },
    "style": { "enum": ["classic", "modern"] },
    "status": { "enum": ["idea", "in-progress", "released"] },
    "brand": { "type": "string", "description": "Brand key in the family (domvirus, battlefield, …)." },
    "repo": { "type": "string", "pattern": "^https://github\\.com/coded-dot-design/[a-z0-9-]+$" },
    "builtFrom": { "type": "array", "items": { "type": "string" } },
    "engine": {
      "type": "object", "required": ["runtime"], "additionalProperties": false,
      "properties": {
        "runtime": { "enum": ["fizlet", "dom-virus-core", "own"], "description": "fizlet for every new game." },
        "bricks": { "type": "array", "items": { "enum": ["input", "collide", "fx", "sound", "embed", "ui", "debug", "hud", "pad", "sprite", "match", "grid", "slot"] } },
        "recipe": { "enum": ["shoot", "dodge", "eat", "jump", "board"], "description": "The gameplay recipe the scaffold composes (factory/templates/recipes/); default eat." }
      }
    },
    "budget": {
      "type": "object", "required": ["gzipBytes"], "additionalProperties": false,
      "properties": { "gzipBytes": { "type": "integer", "minimum": 1024, "maximum": 102400 }, "source": { "type": "string", "description": "Where the number comes from (the size script that enforces it, or why it is provisional)." } }
    },
    "urls": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^https://" } },
    "site": {
      "type": "object",
      "description": "The game's site data, in the shape site-kit reads (site/game.json minus id/author/license). Key order is kept.",
      "required": ["kind", "tagline", "description", "accent", "icon"],
      "properties": {
        "kind": { "type": "string" }, "tagline": { "type": "string" }, "description": { "type": "string" },
        "accent": { "enum": ["amber", "cyan", "lime", "violet", "pink"] }, "icon": { "type": "string" }
      }
    },
    "page": {
      "type": "object",
      "description": "The marketing layer of the game's page, rendered into an astro-base-engine brief.",
      "required": ["site", "type", "slug", "lead", "seo"],
      "additionalProperties": false,
      "properties": {
        "site": { "type": "string", "description": "Which website renders it (dom-virus, dom-battlefield, …)." },
        "type": { "type": "string", "description": "astro-base-engine page type in that site's engine.config.json." },
        "slug": { "type": "string" },
        "eyebrow": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "image": { "type": "string", "pattern": "^(https://|/[^/])", "description": "Share image: absolute https URL, or site-relative (/og/x.png) so the page engine resolves it per target domain" },
        "slots": { "type": "array", "items": { "enum": ["characters", "palette", "related", "embed"] }, "description": "Optional site slots for the astro-base-engine game preset (play, loop, controls and facts are always placed)." },
        "lead": { "type": "string" },
        "support": { "type": "string" },
        "play": { "type": "string", "description": "Label of the Play control (it starts the game; href #play)." },
        "related": {
          "type": "object", "required": ["heading", "items"],
          "properties": {
            "heading": { "type": "string" },
            "items": { "type": "array", "items": { "type": "object", "required": ["title", "body", "label", "href"] } }
          }
        },
        "faq": { "type": "array", "items": { "type": "object", "required": ["q", "a"] } },
        "genre": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Catalog filter and VideoGame genre (e.g. Shooter, Tank, Defense)." },
        "playMode": { "type": "array", "minItems": 1, "items": { "enum": ["SinglePlayer", "MultiPlayer", "CoOp"] }, "description": "schema.org GamePlayMode values; MultiPlayer gives the catalog's multiplayer badge." },
        "players": { "type": "string", "description": "Players in one match, as the catalog card shows it (\"1\", \"1–2\")." },
        "badges": { "type": "array", "items": { "enum": ["new"] }, "description": "Catalog badges the facts back. new: the release the page plays changed what players see (its whatsNew)." },
        "playHref": { "type": "string", "pattern": "^(#play|https://.+)$", "description": "Where Play goes: #play (plays on the page, the default) or the board's own site." },
        "links": { "type": "array", "items": { "$ref": "#/$defs/link" }, "description": "More calls to action after Play (a second mode, the board's site)." },
        "poster": {
          "type": "object", "required": ["src", "alt"], "additionalProperties": false,
          "properties": { "src": { "type": "string", "pattern": "^/[^/]" }, "alt": { "type": "string", "minLength": 20 }, "caption": { "type": "string" } },
          "description": "A real screenshot of the game (site-relative); also the share image unless page.image is set."
        },
        "howToPlay": { "$ref": "#/$defs/items", "description": "How to play, in order (steps)." },
        "controls": { "$ref": "#/$defs/items", "description": "Controls, for a page with no controls slot (boards)." },
        "modes": { "$ref": "#/$defs/items" },
        "tips": { "$ref": "#/$defs/items" },
        "strategy": { "$ref": "#/$defs/items", "description": "Strategy for a game with real depth (STRATEGY block after TIPS): each item follows from the game rules in its repo; nothing invented." },
        "whatsNew": {
          "type": "object", "required": ["version", "date", "items"], "additionalProperties": false,
          "properties": {
            "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
            "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "title": { "type": "string" },
            "items": { "$ref": "#/$defs/items" }
          },
          "description": "From the game's CHANGELOG entry for the version the page plays; player-facing changes only."
        },
        "seo": {
          "type": "object", "required": ["title", "description"],
          "properties": { "title": { "type": "string", "minLength": 30, "maxLength": 60 }, "description": { "type": "string", "minLength": 70, "maxLength": 155 } }
        }
      }
    },
    "prompt": { "type": "string", "description": "The one-line prompt the spec was composed from (fe prompt). Facts still come from the game once built." }
  }
}
