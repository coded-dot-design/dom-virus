{
  "name": "@coded-design/dom-virus",
  "version": "0.2.0",
  "description": "Small DOM arcade runtime and local playground by coded.design",
  "type": "module",
  "license": "MIT",
  "author": "Chris Cooley",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/coded-dot-design/dom-virus.git"
  },
  "scripts": {
    "dev": "node scripts/prepare-playground.mjs && vite --config vite.config.js",
    "build": "npm run build:engine && npm run build:playground",
    "preview": "vite preview --config vite.config.js",
    "test": "node --import tsx --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:package",
    "typecheck": "tsc --noEmit",
    "build:engine": "node scripts/build-engine.mjs",
    "build:playground": "node scripts/prepare-playground.mjs && vite build --config vite.config.js",
    "sync:games": "npm run build:engine && node scripts/sync-games.mjs",
    "test:package": "tsc -p tsconfig.package.json"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.58.2",
    "prettier": "3.6.2",
    "vite": "8.3.5",
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
